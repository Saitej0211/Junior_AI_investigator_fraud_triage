# Copy to .env and fill in. Never commit the real .env.

# Free key from https://console.groq.com/keys. Several keys, comma-separated,
# are tried in order: when one runs out of quota the next is used. Keys from
# the same Groq account share one quota, so extra keys only help from other
# accounts.
GROQ_API_KEY=
# Main model, then a smaller one. The overnight batch sends clear Low cases to
# the smaller one and runs both at once (each has its own rate limit); in the
# app, the second takes over when the first is busy.
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
